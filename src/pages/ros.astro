---
import WorkshopLayout from '../layouts/WorkshopLayout.astro';
import ROSWorkspace from '../components/ros/ROSWorkspace';
---
<WorkshopLayout
	title="ROS 101 — ARC BPHC"
	description="Learn ROS nodes, topics, publishers and subscribers by dragging blocks and driving a robot. No install, no terminal, runs entirely in your browser."
>
	<section class="ros-intro">
		<h1>The ROS ARCade</h1>
		<p>
			Experiment with code blocks that let you make your own fake nodes which control a
			robot in the arena, your goal is to get to the green box at each level, and learn
			something new every time.
		</p>
	</section>

	<ROSWorkspace client:load />
</WorkshopLayout>
<style>
	.ros-intro {
		display: flex;
		flex-direction: column;
		gap: .5rem;
		padding: 1.25rem 0 .25rem;
		max-width: 46rem;
	}

	.ros-intro h1 {
		margin: 0;
		font-family: 'Orbitron', sans-serif;
		font-size: clamp(1.6rem, 3.4vw, 2.4rem);
		letter-spacing: .02em;
	}

	.ros-intro p {
		margin: 0;
		color: #c7c7c7;
		line-height: 1.65;
	}
</style>
