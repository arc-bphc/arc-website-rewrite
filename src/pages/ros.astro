---
import WorkshopLayout from '../layouts/WorkshopLayout.astro';
import WorkshopBar from '../components/ros/WorkshopBar.astro';
import ROSWorkspace from '../components/ros/ROSWorkspace';
---
<WorkshopLayout
	title="ROS 101 — ARC BPHC"
	description="Learn ROS nodes, topics, publishers and subscribers by dragging blocks and driving a robot. No install, no terminal, runs entirely in your browser."
>
	<WorkshopBar session="ROS 101" />

	<section class="ros-intro">
		<h1>Scratch, but for ROS.</h1>
		<p>
			Experiment with code blocks that let you build your own fake nodes and control a
			robot in the arena. Your goal is to reach the green box at each level &mdash; and
			learn something new every time. <strong>Made by your very own ARC.</strong>
		</p>
	</section>

	<ROSWorkspace client:load />
</WorkshopLayout>
<style>
	.ros-intro {
		display: flex;
		flex-direction: column;
		gap: .5rem;
		padding: 1.25rem 0 .25rem;
		max-width: 46rem;
	}

	.ros-intro h1 {
		margin: 0;
		font-family: 'Orbitron', sans-serif;
		font-size: clamp(1.6rem, 3.4vw, 2.4rem);
		letter-spacing: .02em;
	}

	.ros-intro p {
		margin: 0;
		color: #c7c7c7;
		line-height: 1.65;
	}

	.ros-intro strong {
		color: var(--primary);
		font-weight: 600;
	}
</style>
