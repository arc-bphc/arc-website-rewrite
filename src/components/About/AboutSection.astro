---
import { getCollection } from 'astro:content';

import TextReveal from '../TextAnimations/TextReveal';
import ConnectCard from './ConnectCard.astro';
import EventsPanel from './EventsPanel.astro';
import RoboticArm from './RoboticArm';

// QR images are looked up by file name so an entry in connect.json can exist
// before its code has been generated — see src/assets/qr/README.md.
const qrModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/qr/*.{png,jpg,jpeg,webp,svg}',
	{ eager: true },
);

const qrByFile = new Map(
	Object.entries(qrModules).map(([path, mod]) => [path.split('/').pop() as string, mod.default]),
);

const channels = (await getCollection('connect')).sort((a, b) => a.data.order - b.data.order);
---
<section class="about-section">
	<RoboticArm client:visible className="arm-backdrop" />

	<div class="about-content">
		<div class="about-intro">
			<span class="about-eyebrow">// 03 &mdash; Connect</span>
			<TextReveal client:visible
				text="Find Us Here"
				className='text-4xl font-semibold font-[orbitron] pb-6 md:text-6xl'
			/>
			<p class="text-md">
				Scan a code, join the channel, and you'll hear about every workshop, and event we're conducting. Stay up to date and follow us on IG.
			</p>
		</div>

		<div class="about-grid">
			<div class="connect-grid">
				{channels.map((channel) => (
					<ConnectCard channel={channel.data} qr={qrByFile.get(channel.data.qr)} />
				))}
			</div>

			<EventsPanel />
		</div>
	</div>
</section>
<style>
	.about-section {
		position: relative;
		width: 100%;
		overflow: hidden;
		isolation: isolate;
	}

	.about-section :global(.arm-backdrop) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
	}

	.about-content {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		padding: 4rem 2rem;
	}

	.about-intro {
		max-width: 34rem;
	}

	.about-eyebrow {
		display: block;
		font-family: 'Geist Mono', monospace;
		font-size: .75rem;
		letter-spacing: .18em;
		text-transform: uppercase;
		color: var(--primary);
		margin-bottom: .75rem;
	}

	.about-intro p {
		color: #c7c7c7;
		line-height: 1.6;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.connect-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	@media screen and (min-width: 640px) {
		.connect-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media screen and (min-width: 1024px) {
		.about-section {
			/* Gives the manipulator room to read as a backdrop rather than a strip. */
			min-height: 46rem;
		}

		.about-content {
			padding: 6rem 2rem;
		}

		.about-grid {
			grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
			align-items: start;
		}
	}
</style>
