---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import Icon from '../Icon.astro';

interface Props {
	channel: CollectionEntry<'connect'>['data'];
	/** Resolved QR image, or undefined while the file has not been added yet. */
	qr?: ImageMetadata;
}

const { channel, qr } = Astro.props;
---
<a
	class="connect-card"
	href={channel.link}
	target="_blank"
	rel="noopener noreferrer"
	data-cursor-hover
>
	<div class="qr-frame">
		{qr ? (
			<Image src={qr} alt={`QR code linking to ${channel.label}`} width={320} quality={95} />
		) : (
			<div class="qr-pending">
				<Icon type="lucide" name="qr-code" width={40} height={40} />
				<span>Awaiting upload</span>
				<code>{channel.qr}</code>
			</div>
		)}
	</div>

	<div class="connect-meta">
		<div class="connect-title">
			<Icon {...channel.icon} width={18} height={18} class="glow-icon" />
			<h3>{channel.label}</h3>
		</div>
		<span class="connect-handle">{channel.handle}</span>
		<p>{channel.description}</p>
	</div>
</a>
<style>
	.connect-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1rem;
		/* Translucent so the manipulator behind the section stays visible. */
		background-color: rgba(18, 18, 18, .72);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid #353535;
		color: #ffffff;
		text-decoration: none;
		position: relative;
		transition: background-color .15s ease, border-color .15s ease, transform .15s ease;
	}

	/* Corner brackets, drawn only on hover so the resting state stays quiet. */
	.connect-card::before,
	.connect-card::after {
		content: '';
		position: absolute;
		width: 12px;
		height: 12px;
		border: 0 solid var(--primary);
		opacity: 0;
		transition: opacity .15s ease;
	}

	.connect-card::before {
		top: -1px;
		left: -1px;
		border-top-width: 2px;
		border-left-width: 2px;
	}

	.connect-card::after {
		bottom: -1px;
		right: -1px;
		border-bottom-width: 2px;
		border-right-width: 2px;
	}

	.connect-card:hover,
	.connect-card:focus-visible {
		background-color: rgba(30, 34, 14, .82);
		border-color: var(--primary);
		text-decoration: none;
		color: #ffffff;
		transform: translateY(-2px);
		outline: none;
	}

	.connect-card:hover::before,
	.connect-card:hover::after,
	.connect-card:focus-visible::before,
	.connect-card:focus-visible::after {
		opacity: 1;
	}

	.qr-frame {
		aspect-ratio: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #0d0d0d;
		border: 1px solid #262626;
		padding: .75rem;
	}

	.qr-frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.qr-pending {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: .5rem;
		border: 1px dashed #3f3f3f;
		color: #6b6b6b;
		text-align: center;
		padding: .5rem;
	}

	.qr-pending span {
		font-family: 'Geist Mono', monospace;
		font-size: .7rem;
		letter-spacing: .08em;
		text-transform: uppercase;
	}

	.qr-pending code {
		font-family: 'Geist Mono', monospace;
		font-size: .65rem;
		color: #4f4f4f;
	}

	.connect-meta {
		display: flex;
		flex-direction: column;
		gap: .25rem;
	}

	.connect-title {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: .5rem;
	}

	.connect-title h3 {
		margin: 0;
		font-family: 'Orbitron', sans-serif;
		font-size: 1rem;
		letter-spacing: .04em;
	}

	.connect-handle {
		font-family: 'Geist Mono', monospace;
		font-size: .8rem;
		color: var(--primary-light);
	}

	.connect-meta p {
		margin: .25rem 0 0;
		font-size: .8rem;
		line-height: 1.5;
		color: #c7c7c7;
	}
</style>
