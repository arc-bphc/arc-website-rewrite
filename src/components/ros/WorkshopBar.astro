---
/**
 * Co-branding strip for the workshop, sitting directly under the site nav.
 *
 * This is not a second navbar: no links, no search, no mobile menu. It exists
 * only to say whose workshop this is and which session you are in.
 *
 * There is no Aeolus mark in the repo yet, so the lockup is set in type. Drop a
 * logo into src/assets/ and swap the <span> for an <Image> when one exists.
 */
interface Props {
	session?: string;
}

const { session = 'ROS 101' } = Astro.props;
---
<div class="workshop-bar">
	<div class="lockup">
		<span class="brand">ARC</span>
		<span class="cross" aria-hidden="true">&times;</span>
		<span class="brand">AEOLUS</span>
	</div>

	<div class="session">
		<span class="dot" aria-hidden="true"></span>
		<span>{session}</span>
		<span class="sep" aria-hidden="true">/</span>
		<span class="muted">Interactive</span>
	</div>
</div>
<style>
	.workshop-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: .625rem 1rem;
		border: 1px solid #353535;
		background-color: #121212;
		font-family: 'Geist Mono', monospace;
		font-size: .75rem;
	}

	.lockup {
		display: flex;
		align-items: center;
		gap: .6rem;
	}

	.brand {
		font-family: 'Orbitron', sans-serif;
		font-weight: 700;
		letter-spacing: .16em;
		font-size: .8rem;
	}

	.cross {
		color: var(--primary);
		font-size: .9rem;
		line-height: 1;
	}

	.session {
		display: flex;
		align-items: center;
		gap: .5rem;
		letter-spacing: .1em;
		text-transform: uppercase;
	}

	.dot {
		width: 6px;
		height: 6px;
		background-color: var(--primary);
		box-shadow: 0 0 8px var(--primary);
	}

	.sep {
		color: #4f4f4f;
	}

	.muted {
		color: #8a8a8a;
	}

	@media screen and (max-width: 640px) {
		.workshop-bar {
			font-size: .7rem;
			padding: .5rem .75rem;
		}
	}
</style>
