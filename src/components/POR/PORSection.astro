---
import { getCollection } from "astro:content";

import TextReveal from "../TextAnimations/TextReveal";

// Photos are looked up by file name so an entry in por.json can exist before
// its photo has been added — see src/assets/por/README.md.
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
	"../../assets/por/*.{png,jpg,jpeg,webp}",
	{ eager: true },
);

const photoByFile = new Map(
	Object.entries(photoModules).map(([path, mod]) => [
		path.split("/").pop() as string,
		mod.default,
	]),
);

const positions = (await getCollection("por")).sort(
	(a, b) => a.data.order - b.data.order,
);

function getInitials(name: string): string {
	return name
		.split(" ")
		.filter(Boolean)
		.map((part) => part[0])
		.slice(0, 2)
		.join("")
		.toUpperCase();
}
---
<section class="por-section">
	<div class="por-intro">
		<span class="por-eyebrow">Leadership</span>
		<TextReveal client:visible
			text="People of Responsibility"
			className='text-4xl font-semibold font-[orbitron] pb-6 md:text-6xl'
		/>
	</div>

	<div class="por-grid">
		{positions.map(({ data }) => {
			const photo = data.image ? photoByFile.get(data.image) : undefined;
			return (
				<div class="por-card">
					<div class="por-avatar">
						{photo ? (
							<img src={photo.src} alt={data.name} width={photo.width} height={photo.height} loading="lazy" />
						) : (
							<span class="por-initials">{getInitials(data.name)}</span>
						)}
					</div>
					<div class="por-info">
						<h4>{data.name}</h4>
						<span class="por-role">{data.role}</span>
					</div>
				</div>
			);
		})}
	</div>
</section>

<style>
	.por-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2.5rem;
		padding: 4rem 2rem;
	}

	.por-intro {
		max-width: 34rem;
	}

	.por-eyebrow {
		display: block;
		font-family: 'Geist Mono', monospace;
		font-size: .75rem;
		letter-spacing: .18em;
		text-transform: uppercase;
		color: var(--primary);
		margin-bottom: .75rem;
	}

	.por-intro p {
		color: #c7c7c7;
		line-height: 1.6;
	}

	.por-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		width: 100%;
		max-width: 1100px;
	}

	.por-card {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 1rem;
		padding: 1.25rem;
		background-color: rgba(18, 18, 18, .72);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid #353535;
	}

	.por-avatar {
		flex-shrink: 0;
		width: 3.5rem;
		height: 3.5rem;
		overflow: hidden;
		border: 1px solid var(--primary-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #1a1a1a;
	}

	.por-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.por-initials {
		font-family: 'Geist Mono', monospace;
		font-size: 1rem;
		letter-spacing: .04em;
		color: var(--primary);
	}

	.por-info {
		display: flex;
		flex-direction: column;
		gap: .2rem;
		min-width: 0;
	}

	.por-info h4 {
		margin: 0;
		font-family: 'Orbitron', sans-serif;
		font-size: .95rem;
		font-weight: 600;
		letter-spacing: .02em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.por-role {
		font-family: 'Geist Mono', monospace;
		font-size: .75rem;
		color: var(--primary-light);
	}

	@media screen and (min-width: 640px) {
		.por-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media screen and (min-width: 1024px) {
		.por-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		/* Centers the 7th card cleanly inside column 2 of the final row */
		.por-grid > .por-card:last-child {
			grid-column: 2;
		}

		.por-section {
			padding: 6rem 2rem;
		}
	}
</style>
